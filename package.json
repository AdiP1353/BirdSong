{
  "name": "birdsong",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "demo": "bash scripts/demo.sh",
    "demo:stop": "bash scripts/demo.sh --stop",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "~5.8.3",
    "vitest": "^5.1.0"
  }
}
