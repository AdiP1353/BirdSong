# Reverse proxy for the simulated mesh (docker/compose.sim.yml).
# Port 3100 is the only host port that reaches the nodes and the ether.
# Keep the port in sync with PROXY_PORT in packages/core/src/telemetry.ts.
{
	admin off
	auto_https off
}

:3100 {
	# /nodes/<id>/... goes to the container reachable as bird<id> on the compose network: bird0..bird7 from
	# compose, plus any bird the dashboard adds (the nursery gives each the alias bird<id>).
	@bare path_regexp bare ^/nodes/(\d{1,3})$
	redir @bare /nodes/{re.bare.1}/ 308
	@node path_regexp node ^/nodes/(\d{1,3})(/.*)$
	handle @node {
		rewrite * {re.node.2}?{query}
		reverse_proxy bird{re.node.1}:8080
	}
	# Only the listen socket is public. The ether's /topology control API is reached by the hub on the
	# compose network, never through this proxy.
	redir /ether /ether/ 308
	handle /ether/listen {
		uri strip_prefix /ether
		reverse_proxy ether:7080
	}
	handle /ether/* {
		respond "Only /ether/listen is public. Change the topology from the dashboard (port 3200)." 404
	}
	handle {
		respond "BirdSong proxy. Nodes: /nodes/<id>/. Simulated air: /ether/listen (WebSocket). Dashboard: port 3200." 404
	}
}
